# Normalize line endings: LF in the repository and in working trees.
# The dev environment is WSL2/Linux; Windows editors must respect LF.
* text=auto eol=lf

# Explicitly LF-critical files
Makefile text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
